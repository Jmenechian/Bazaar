ENVIRONMENT=development
PORT=8001

# PostgreSQL Configuration
DB_USER=user
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bazaar_users

# Alternatively, a single connection string:
# DATABASE_URL=postgresql+psycopg2://bazaar:bazaar@localhost:5432/bazaar_users

# Auth / JWT Configuration
SECRET_KEY=bazaar-development-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
